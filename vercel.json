{
  "version": 2,
  "buildCommand": "npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "build",
  "devCommand": "npm start",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "create-react-app",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/sitemap-index.xml",
      "dest": "/sitemap-index.xml",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/local-business-schema.json",
      "dest": "/local-business-schema.json",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/BingSiteAuth.xml",
      "dest": "/BingSiteAuth.xml",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/.well-known/security.txt",
      "dest": "/.well-known/security.txt",
      "headers": {
        "Content-Type": "text/plain"
      }
    },
    {
      "src": "/gallery/(.*)",
      "dest": "/gallery/$1"
    },
    {
      "src": "/tp-logo.png",
      "dest": "/tp-logo.png"
    },
    {
      "src": "/v.venktesulu.png",
      "dest": "/v.venktesulu.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

